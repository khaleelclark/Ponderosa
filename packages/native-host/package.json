{
  "name": "@ponderosa/native-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node-gyp rebuild",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:built": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "node-gyp": "^12.1.0",
    "typescript": "^5.7.2"
  }
}
