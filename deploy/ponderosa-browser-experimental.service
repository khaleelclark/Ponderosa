[Unit]
Description=Ponderosa experimental browser supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=phoenix
WorkingDirectory=/home/phoenix/ponderosa-project-rail-runtime/current
Environment=NODE_ENV=production
Environment=PONDEROSA_DATA_DIR=/home/phoenix/.local/state/ponderosa-project-rail-runtime
Environment=PONDEROSA_BROWSER_SERVICE_SOCKET=/run/ponderosa-browser-experimental/browser.sock
Environment=PONDEROSA_BROWSER_EXECUTABLE=/usr/bin/google-chrome-stable
Environment=PONDEROSA_BROWSER_MULTI_PAGE=1
Environment=PONDEROSA_BROWSER_FILE_UPLOAD=1
RuntimeDirectory=ponderosa-browser-experimental
RuntimeDirectoryMode=0700
UMask=0077
ExecStart=/home/phoenix/ponderosa-project-rail-runtime/current/dist/node-runtime/linux-x64/node apps/server/dist/browser-service-main.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=multi-user.target
