# Optional Unix-socket HTTP bridge. Edit paths/user before installing.
[Unit]
Description=Ponderosa Unix-socket HTTP bridge
After=network-online.target ponderosa.service
Wants=network-online.target

[Service]
Type=simple
User=khaleel
EnvironmentFile=%h/.config/ponderosa/release.env
Environment=PONDEROSA_PROXY_BACKEND_PORT=8787
Environment=PONDEROSA_PROXY_PUBLIC_ORIGIN=https://ponderosa.example.ts.net
Environment=PONDEROSA_PROXY_SOCKET_PATH=/run/ponderosa-operator-proxy/operator.sock
RuntimeDirectory=ponderosa-operator-proxy
RuntimeDirectoryMode=0700
WorkingDirectory=/opt/ponderosa-engine/resources/Ponderosa
ExecStart=/opt/ponderosa-engine/resources/Ponderosa/runtime/node app/server/dist/operator-auth-proxy.js
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
