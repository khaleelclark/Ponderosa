# Ponderosa — systemd unit (SPEC §10).
# Runs the Fastify daemon as your login user so the engine CLIs it spawns inherit
# real fs/shell access, the on-disk subscription tokens (~/.codex, ~/.claude), and
# each project's md files — no bind mounts (SPEC §10/§11).
#
# Install:
#   sudo cp deploy/ponderosa.service /etc/systemd/system/ponderosa.service
#   # edit User=, WorkingDirectory=, and PONDEROSA_DATA_DIR below to match the host
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ponderosa
#   systemctl status ponderosa
#
# The default listener is loopback-only. Remote reachability is an explicit
# security choice — see deploy/README.md.
#
# Artifact safety requires Linux with visible /proc/self/fd. Do not add
# InaccessiblePaths=/proc, mask /proc/self/fd, or run this unit in a container
# without a procfs mount. The daemon reports the capability through /api/ready.

[Unit]
Description=Ponderosa coding-agent workbench
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run as your normal login user (NOT root) — engines inherit this user's access
# and its `codex login` token under ~/.codex.
User=khaleel
WorkingDirectory=/home/khaleel/ponderosa
Environment=NODE_ENV=production
# The one greppable, portable data dir (event logs + SQLite projections, SPEC §7).
Environment=PONDEROSA_DATA_DIR=/home/khaleel/.ponderosa
# Web Push credentials are generated outside the repository by
# `pnpm --filter @ponderosa/server push:configure` (see deploy/README.md).
# The leading `-` keeps Web Push optional on hosts that have not configured it.
EnvironmentFile=-%h/.config/ponderosa/push.env
# Codex agents need full access on the single-operator host so their shell commands
# can use outbound network operations such as git push / gh pr create.
Environment=PONDEROSA_CODEX_SANDBOX=danger-full-access
# Optional: bind host/port (defaults 127.0.0.1:8787).
# Environment=PONDEROSA_PORT=8787
# A non-loopback listener fails startup unless PONDEROSA_AUTH_TOKEN is set, or
# trusted-tailnet mode is explicitly enabled on one literal Tailscale address.
# Never place PONDEROSA_AUTH_TOKEN in browser code or localStorage.
# Environment=PONDEROSA_HOST=100.100.101.102
# Environment=PONDEROSA_TRUSTED_TAILNET=true
# Optional runtime callback origin (defaults to http://127.0.0.1:PONDEROSA_PORT).
# Environment=PONDEROSA_AGENT_BASE_URL=http://127.0.0.1:8787
# Optional warm-runtime pool size. Active runs are never evicted; idle agents
# resume their durable provider session after eviction. Defaults to 8.
# Environment=PONDEROSA_MAX_IDLE_RUNTIME_SESSIONS=8
# Optional host Chromium/Chrome binary for run-scoped interactive browsers.
# Common /usr/bin paths are detected automatically.
# Environment=PONDEROSA_BROWSER_EXECUTABLE=/usr/bin/chromium
#
# IMPORTANT — engine binaries on PATH. Ponderosa spawns `codex` and `claude` by
# name. systemd's default PATH is minimal and usually does NOT include npm-global
# or a version-manager bin dir, so the engines fail with "failed to spawn …".
# Set PATH to include wherever `which codex` / `which claude` resolve for User=.
# (A system Node install puts npm globals in /usr/local/bin, already covered; nvm/
# fnm/custom-prefix installs do NOT — add that dir here.)
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/khaleel/.npm-global/bin
ExecStart=/usr/bin/node apps/server/dist/main.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
