{
  "name": "@ponderosa/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "rsbuild build",
    "dev": "rsbuild dev",
    "preview": "rsbuild preview",
    "test:built": "sh -c 'tmp=$(mktemp -d); trap \"rm -rf \\\"$tmp\\\"\" EXIT; tsc --module NodeNext --moduleResolution NodeNext --target ES2022 --skipLibCheck --outDir \"$tmp\" --rootDir . src/components/allChatRouting.ts src/components/chat/composerDestination.ts && mkdir -p \"$tmp/test\" && cp test/all-chat-routing.test.mjs \"$tmp/test/\" && node --test \"$tmp/test/all-chat-routing.test.mjs\"'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@lexical/react": "^0.49.0",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.3.0",
    "@ponderosa/core": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "lexical": "^0.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "rsbuild-plugin-pwa": "^2.10.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.1.0",
    "@rsbuild/plugin-react": "^1.1.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "typescript": "^5.7.2"
  }
}
