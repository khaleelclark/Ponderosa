{
  "name": "@ponderosa/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:built": "pnpm build && node --test test/*.test.mjs",
    "start": "node dist/main.js",
    "dev": "node --watch --experimental-strip-types src/main.ts"
  },
  "dependencies": {
    "@ponderosa/agents": "workspace:*",
    "@ponderosa/core": "workspace:*",
    "@ponderosa/engines": "workspace:*",
    "@ponderosa/native-host": "workspace:*",
    "better-sqlite3": "^11.10.0",
    "chokidar": "^5.0.0",
    "croner": "^10.0.1",
    "fastify": "^5.2.0",
    "libheif-js": "1.23.2",
    "picomatch": "^4.0.5",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@types/picomatch": "^4.0.3",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.2"
  }
}
