{
  "name": "@ponderosa/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "test:built": "node ../../tests/shared/run-tests.mjs --lane server"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "@ponderosa/agents": "workspace:*",
    "@ponderosa/core": "workspace:*",
    "@ponderosa/engines": "workspace:*",
    "@ponderosa/native-host": "workspace:*",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.12.1",
    "libheif-js": "1.23.2",
    "playwright-core": "1.63.0",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.2"
  }
}
