{
  "name": "@ponderosa/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && vitest run --exclude test/main-shutdown.e2e.test.ts && vitest run test/main-shutdown.e2e.test.ts",
    "test:filesystem-watcher-latency": "PONDEROSA_RUN_FILESYSTEM_WATCHER_LATENCY_TESTS=1 vitest run test/trigger-service.test.ts --no-file-parallelism --maxWorkers=1 --testNamePattern=\"shares one Project watcher|restores a persisted filesystem quiet-window burst after service restart\"",
    "start": "node dist/main.js",
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "push:configure": "node dist/configure-web-push.js"
  },
  "dependencies": {
    "@ponderosa/agents": "workspace:*",
    "@ponderosa/core": "workspace:*",
    "@ponderosa/engines": "workspace:*",
    "better-sqlite3": "^11.10.0",
    "chokidar": "^5.0.0",
    "croner": "^10.0.1",
    "fastify": "^5.2.0",
    "picomatch": "^4.0.5",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/picomatch": "^4.0.3",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
