{
  "name": "@ponderosa/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js",
    "dev": "node --watch --experimental-strip-types src/main.ts"
  },
  "dependencies": {
    "@ponderosa/core": "workspace:*",
    "@ponderosa/engines": "workspace:*",
    "@ponderosa/threads": "workspace:*",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
