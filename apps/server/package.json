{
  "name": "@ponderosa/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js",
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "push:configure": "node dist/configure-web-push.js"
  },
  "dependencies": {
    "@ponderosa/agents": "workspace:*",
    "@ponderosa/core": "workspace:*",
    "@ponderosa/engines": "workspace:*",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.2.0",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
