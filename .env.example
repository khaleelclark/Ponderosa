# Ponderosa environment configuration
# Copy to `.env` and adjust. `.env` is gitignored — never commit real values.

# Where Ponderosa stores its data: event logs (canonical) + SQLite projections.
# This whole directory is your backup unit (SPEC §7). If unset, a per-OS default
# is auto-detected by packages/core (e.g. ~/.ponderosa).
PONDEROSA_DATA_DIR=/home/khaleel/.ponderosa

# HTTP port for the Fastify daemon.
PONDEROSA_PORT=8787

# Host-local origin injected into agent messaging/delegation tools. Agents run on
# this host, so loopback avoids relying on a reverse proxy or public DNS.
PONDEROSA_AGENT_BASE_URL=http://127.0.0.1:8787

# Maximum completed engine runtimes kept warm for fast follow-up/steering. Active
# runs are never evicted. Provider session IDs remain durable, so an evicted
# agent resumes normally on its next message instead of retaining an MCP process
# indefinitely. Defaults to 8; use 0 on memory-constrained hosts.
PONDEROSA_MAX_IDLE_RUNTIME_SESSIONS=8

# Node environment.
NODE_ENV=development
