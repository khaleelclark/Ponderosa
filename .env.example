# Ponderosa environment configuration
# Copy to `.env` and adjust. `.env` is gitignored — never commit real values.

# Where Ponderosa stores its data: event logs (canonical) + SQLite projections.
# This whole directory is your backup unit (SPEC §7). If unset, a per-OS default
# is auto-detected by packages/core (e.g. ~/.ponderosa). To override it, use an
# absolute path owned by the account that runs Ponderosa.
# PONDEROSA_DATA_DIR=/absolute/path/to/.ponderosa

# HTTP port for the Fastify daemon.
PONDEROSA_PORT=8787

# Safe default: listen only on this host.
PONDEROSA_HOST=127.0.0.1

# A non-loopback listener requires exactly one of the following boundaries.
# Browser clients must never store this bearer token in application code or
# localStorage; use an authenticated reverse proxy that injects it.
# PONDEROSA_AUTH_TOKEN=replace-with-a-long-random-secret
#
# Or intentionally expose one literal Tailscale address to trusted tailnet
# peers. Every peer that can reach it receives full operator authority.
# PONDEROSA_HOST=100.100.101.102
# PONDEROSA_TRUSTED_TAILNET=true

# Host-local origin injected into agent messaging/delegation tools. Agents run on
# this host, so loopback avoids relying on a reverse proxy or public DNS.
PONDEROSA_AGENT_BASE_URL=http://127.0.0.1:8787

# Maximum completed engine runtimes kept warm for fast follow-up/steering. Active
# runs are never evicted. Provider session IDs remain durable, so an evicted
# agent resumes normally on its next message instead of retaining an MCP process
# indefinitely. Defaults to 8; use 0 on memory-constrained hosts.
PONDEROSA_MAX_IDLE_RUNTIME_SESSIONS=8

# PONDEROSA_LAUNCHER_CONTROL_TOKEN is generated and injected by the desktop
# launcher. Do not set or persist it manually.

# Node environment.
NODE_ENV=development
