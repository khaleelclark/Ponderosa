# Ponderosa environment configuration
# Copy to `.env` and adjust. `.env` is gitignored — never commit real values.

# Where Ponderosa stores its data: event logs (canonical) + SQLite projections.
# This whole directory is your backup unit (SPEC §7). If unset, a per-OS default
# is auto-detected by packages/core (e.g. ~/.ponderosa).
PONDEROSA_DATA_DIR=/home/khaleel/.ponderosa

# HTTP port for the Fastify daemon.
PONDEROSA_PORT=8787

# Node environment.
NODE_ENV=development
