{
  "name": "ponderosa",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted coding-agent workbench",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @ponderosa/core build && pnpm --filter @ponderosa/native-host build && pnpm --filter @ponderosa/agents build && pnpm --filter @ponderosa/engines build && pnpm -r typecheck",
    "test": "pnpm typecheck && pnpm -r --if-present test:built",
    "test:speech-browser": "node apps/web/test/speech-browser.check.mjs",
    "verify": "pnpm test && pnpm build",
    "clean": "pnpm -r exec rm -rf dist",
    "start:prod": "NODE_ENV=production node apps/server/dist/main.js",
    "beta:version": "node packaging/beta-version.mjs",
    "beta:cut": "node packaging/beta-version.mjs --cut --push",
    "beta:node": "node packaging/prepare-node-runtime.mjs",
    "beta:bundle": "pnpm build && node packaging/build-beta-bundle.mjs",
    "beta:package": "node packaging/package-beta.mjs",
    "beta:verify": "node packaging/verify-beta-bundle.mjs"
  }
}
