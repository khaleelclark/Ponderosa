{
  "name": "ponderosa",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted coding-agent workbench",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r exec rm -rf dist",
    "engines:try": "node packages/engines/dist/harness.js",
    "start:prod": "NODE_ENV=production node apps/server/dist/main.js"
  }
}
